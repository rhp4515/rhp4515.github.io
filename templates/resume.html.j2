<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ profile.name }} — Resume</title>
<style>
    @page { size: Letter; margin: 0; }
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
        margin: 0;
        background: #ffffff;
        color: #111111;
        font-family: Georgia, 'Times New Roman', Times, serif;
        font-size: 9.5pt;
        line-height: 1.15;
    }
    a { color: #1a56db; text-decoration: none; }
    p { margin: 0; }
    ul { list-style: disc; padding-left: 18px; margin: 3px 0 8px; }
    li { margin-bottom: 2px; }
    li:last-child { margin-bottom: 0; }
    .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .bold { font-weight: 700; }
    .italic { font-style: italic; }
    .muted { color: #444; }

    header.resume-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    header.resume-header h1 { margin: 0; font-size: 22pt; font-weight: 700; line-height: 1.1; }
    .tagline { margin-top: 1px; font-size: 9.5pt; font-style: italic; color: #2f6db5; text-decoration: underline; }
    .contact-block { text-align: right; font-size: 9pt; line-height: 1.3; }

    section { margin-top: 7px; }
    section h2 {
        font-size: 11pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: #3f78c0;
        margin: 0 0 4px;
        break-after: avoid;
    }

    .edu-entry, .publication { break-inside: avoid; margin-bottom: 4px; }
    .edu-entry:last-child, .publication:last-child { margin-bottom: 0; }

    .role-entry { break-inside: avoid; margin-top: 6px; }
    .role-entry:first-child { margin-top: 0; }
    .charter { margin: 1px 0 0; }

    .skills-list { list-style: none; padding-left: 0; margin: 0; }
    .skills-list li { margin-bottom: 1px; }

    footer.resume-footer { margin-top: 4px; font-size: 7.5pt; color: #666; }
</style>
</head>
<body>
    <div style="padding: 0.35in 0.6in 0.2in;">

        <header class="resume-header">
            <div>
                <h1>{{ profile.name }}</h1>
                <div class="tagline">{{ profile.eyebrow }}</div>
            </div>
            <div class="contact-block">
                <div><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></div>
                <div><a href="{{ contact.linkedin }}">{{ contact.linkedin|replace('https://www.', '') }}</a> &nbsp;·&nbsp; <a href="{{ contact.github }}">{{ contact.github|replace('https://', '') }}</a></div>
                <div class="italic">{{ career.location }}</div>
            </div>
        </header>

        <section>
            <h2>Work Experience</h2>
{% for group in experience_groups %}
{% for role in group.roles %}
            <div class="role-entry">
                <div class="row">
                    <span><span class="bold">{{ group.company }}{% if group.location %}, {{ group.location }}{% endif %} –</span> <span class="italic">{{ role.job_title }}</span></span>
                    <span class="italic">{{ role.pdf_dates }}</span>
                </div>
{% for label, text in role.facts if label == 'scope' %}
                <p class="charter"><span class="bold">Charter:</span> <span class="italic">{{ text }}</span></p>
{% endfor %}
                <ul>
{% for label, text in role.facts if label != 'scope' %}
                    <li>{% if not label.startswith('impact') %}<span class="bold">{{ label|capitalize }}:</span> {% endif %}{{ text }}</li>
{% endfor %}
                </ul>
            </div>
{% endfor %}
{% endfor %}
        </section>

        <section>
            <h2>Skills</h2>
            <ul class="skills-list">
{% for label, value in toolkit %}
                <li><span class="bold">{{ label[0]|upper }}{{ label[1:] }}:</span> {{ value|replace(' · ', ', ') }}</li>
{% endfor %}
            </ul>
        </section>

        <section>
            <h2>Education</h2>
{% for degree in education.degrees %}
{% set parts = degree.meta.split(' · ') %}
            <div class="edu-entry">
                <div class="row"><span class="bold">{{ parts[0] }}</span><span class="italic">{{ parts[-1] }}</span></div>
                <div>{{ degree.name }}{% if parts|length > 2 %} · {{ parts[1:-1]|join(' · ') }}{% endif %}</div>
            </div>
{% endfor %}
        </section>

        <section>
            <h2>Research Experience</h2>
{% for pub in education.publications %}
            <div class="publication">
                <p><span class="bold">{{ pub.title }}</span></p>
                <p class="muted">{{ pub.venue }}</p>
            </div>
{% endfor %}
        </section>

        <footer class="resume-footer">
            <div class="row">
                <span>{{ profile.name }} · {{ career.location }}</span>
                <span>Updated {{ last_deploy }}</span>
            </div>
        </footer>
    </div>
</body>
</html>
